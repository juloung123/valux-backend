generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(cuid())
  address    String      @unique @map("wallet_address")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  portfolios Portfolio[]
  rules      Rule[]

  @@map("users")
}

model Vault {
  id                 String             @id @default(cuid())
  name               String
  address            String             @unique @map("contract_address")
  protocol           String
  tokenAddress       String             @map("token_address")
  tokenSymbol        String             @map("token_symbol")
  apy                Float
  riskLevel          String             @map("risk_level")
  category           String
  tvl                Decimal            @db.Decimal(20, 8)
  active             Boolean            @default(true)
  insuranceAvailable Boolean            @default(false) @map("insurance_available")
  autoCompounding    Boolean            @default(false) @map("auto_compounding")
  withdrawalTerms    String?            @map("withdrawal_terms")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  portfolios         Portfolio[]
  rules              Rule[]
  vaultPerformance   VaultPerformance[]

  @@map("vaults")
}

model VaultPerformance {
  id        String   @id @default(cuid())
  vaultId   String   @map("vault_id")
  apy       Float
  tvl       Decimal  @db.Decimal(20, 8)
  timestamp DateTime @default(now())
  vault     Vault    @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([vaultId, timestamp])
  @@map("vault_performance")
}

model Rule {
  id              String          @id @default(cuid())
  name            String
  description     String?
  userId          String          @map("user_id")
  vaultId         String          @map("vault_id")
  trigger         String
  profitThreshold Decimal?        @map("profit_threshold") @db.Decimal(20, 8)
  active          Boolean         @default(true)
  lastExecuted    DateTime?       @map("last_executed")
  nextExecution   DateTime?       @map("next_execution")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  distributions   Distribution[]
  executions      RuleExecution[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vault           Vault           @relation(fields: [vaultId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vaultId])
  @@index([nextExecution])
  @@map("rules")
}

model Distribution {
  id          String  @id @default(cuid())
  ruleId      String  @map("rule_id")
  recipient   String
  percentage  Float
  description String?
  type        String  @default("wallet")
  rule        Rule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("distributions")
}

model RuleExecution {
  id             String   @id @default(cuid())
  ruleId         String   @map("rule_id")
  executedAt     DateTime @default(now()) @map("executed_at")
  profitAmount   Decimal  @map("profit_amount") @db.Decimal(20, 8)
  gasUsed        Decimal? @map("gas_used") @db.Decimal(20, 8)
  gasFee         Decimal? @map("gas_fee") @db.Decimal(20, 8)
  transactions   Json
  status         String
  errorMessage   String?  @map("error_message")
  performanceFee Decimal? @map("performance_fee") @db.Decimal(20, 8)
  rule           Rule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([executedAt])
  @@index([status])
  @@map("rule_executions")
}

model Portfolio {
  id               String        @id @default(cuid())
  userId           String        @map("user_id")
  vaultId          String        @map("vault_id")
  depositAmount    Decimal       @map("deposit_amount") @db.Decimal(20, 8)
  currentValue     Decimal       @map("current_value") @db.Decimal(20, 8)
  unrealizedPnl    Decimal       @map("unrealized_pnl") @db.Decimal(20, 8)
  realizedPnl      Decimal       @map("realized_pnl") @db.Decimal(20, 8)
  totalDistributed Decimal       @default(0) @map("total_distributed") @db.Decimal(20, 8)
  avgAPY           Float?        @map("avg_apy")
  firstDepositAt   DateTime      @map("first_deposit_at")
  lastUpdated      DateTime      @default(now()) @map("last_updated")
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vault            Vault         @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  transactions     Transaction[]

  @@unique([userId, vaultId])
  @@index([userId])
  @@index([vaultId])
  @@map("portfolios")
}

model Transaction {
  id          String    @id @default(cuid())
  portfolioId String    @map("portfolio_id")
  hash        String    @unique @map("transaction_hash")
  type        String
  amount      Decimal   @db.Decimal(20, 8)
  tokenSymbol String    @map("token_symbol")
  status      String
  blockNumber Int?      @map("block_number")
  gasUsed     Decimal?  @map("gas_used") @db.Decimal(20, 8)
  gasFee      Decimal?  @map("gas_fee") @db.Decimal(20, 8)
  fromAddress String?   @map("from_address")
  toAddress   String?   @map("to_address")
  executedAt  DateTime  @default(now()) @map("executed_at")
  confirmedAt DateTime? @map("confirmed_at")
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([hash])
  @@index([type])
  @@index([status])
  @@index([executedAt])
  @@map("transactions")
}

model PlatformAnalytics {
  id                   String   @id @default(cuid())
  date                 DateTime @unique @map("analytics_date") @db.Date
  totalTVL             Decimal  @map("total_tvl") @db.Decimal(20, 8)
  totalUsers           Int      @map("total_users")
  activeUsers24h       Int      @map("active_users_24h")
  totalTransactions    Int      @map("total_transactions")
  transactionVolume24h Decimal  @map("transaction_volume_24h") @db.Decimal(20, 8)
  totalFeesGenerated   Decimal  @map("total_fees_generated") @db.Decimal(20, 8)
  feesGenerated24h     Decimal  @map("fees_generated_24h") @db.Decimal(20, 8)
  totalRules           Int      @map("total_rules")
  activeRules          Int      @map("active_rules")
  totalDistributed     Decimal  @map("total_distributed") @db.Decimal(20, 8)
  avgAPY               Float    @map("avg_apy")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("platform_analytics")
}
